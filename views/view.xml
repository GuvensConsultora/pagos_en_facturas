<odoo>
    <data>
        <record id="view_invoice_form_inherit_pago_inmediato" model="ir.ui.view">
            <field name="name">account.move.form.inherit.pago.inmediato</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_left_group']" position="inside">
		  <group name="div_pago_inmediato" colspan="2"
			 invisible="invoice_payment_term_id != 1"
			 style="background-color: #FFEBEE; border-radius: 5px;">
		    <field name="x_efectivo" string="Monto en efectivo: "/>
		    <field name="x_imp_mp" string="Monto en M.P." />
		    <field name="x_nro_mp" string="Nro operacion en M.P." />
		    <field name="x_imp_tarj" string="Monto en Tarjeta:" />
		    <field name="x_nro_tarj" string="Nro de cupón: " />
		    <field name="x_saldo_favor" string="Saldo a Favor: " readonly="1"/>
		    <field name="x_neto" string="Monto neto a pagar: " readonly="1" />
                  </group> 
                </xpath>
            </field>
        </record>
	<record id="view_company_form_inherit_topecf" model="ir.ui.view">
	  <field name="name">res.company.form.inherit.topecf</field>
	  <field name="model">res.company</field>
	  <field name="inherit_id" ref="base.view_company_form"/>
	  <field name="arch" type="xml">
	    <!-- Inserta x_tope_cf justo después de VAT -->
	    <xpath expr="//notebook/page[@name='general_info']//field[@name='vat']"
		   position="after">
              <!--<field name="x_tope_cf" string="Imp Max. Cons Fin Anónimo"/>-->
	    </xpath>

	  </field>
	</record>
    </data>
</odoo>
